@@ -0,0 +1,34 @@
+package com.tailscale.ipn
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.Network
+import android.net.NetworkCapabilities
+import org.junit.Assert.*
+import org.junit.Test
+import org.mockito.Mockito.*
+
+class VpnNetworkDetectionTest {
+  @Test fun detectsVpnOnLegacyAndroidWithoutDefaultNetworkApi() {
+    val context = mock(Context::class.java)
+    val manager = mock(ConnectivityManager::class.java)
+    val network = mock(Network::class.java)
+    val caps = mock(NetworkCapabilities::class.java)
+    `when`(context.getSystemService(Context.CONNECTIVITY_SERVICE)).thenReturn(manager)
+    `when`(manager.allNetworks).thenReturn(arrayOf(network))
+    `when`(manager.getNetworkCapabilities(network)).thenReturn(caps)
+    `when`(caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)).thenReturn(true)
+    val activity = mock(MainActivity::class.java, CALLS_REAL_METHODS)
+    assertTrue(activity.isAnotherVpnActive(context))
+    verify(manager, never()).activeNetwork
+  }
+  @Test fun absentNetworkCapabilitiesAreNotAVpn() {
+    val context = mock(Context::class.java)
+    val manager = mock(ConnectivityManager::class.java)
+    val network = mock(Network::class.java)
+    `when`(context.getSystemService(Context.CONNECTIVITY_SERVICE)).thenReturn(manager)
+    `when`(manager.allNetworks).thenReturn(arrayOf(network))
+    val activity = mock(MainActivity::class.java, CALLS_REAL_METHODS)
+    assertFalse(activity.isAnotherVpnActive(context))
+  }
+}
