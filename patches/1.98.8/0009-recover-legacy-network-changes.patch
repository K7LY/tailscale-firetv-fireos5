+++ b/android/src/test/kotlin/com/tailscale/ipn/NetworkChangeCallbackTest.kt
@@ -0,0 +1,148 @@
+package com.tailscale.ipn
+
+import android.app.Application
+import android.net.ConnectivityManager
+import android.net.LinkProperties
+import android.net.Network
+import android.net.NetworkCapabilities
+import android.net.NetworkRequest
+import com.tailscale.ipn.util.TSLog
+import java.net.InetAddress
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.Mockito.*
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [22], application = Application::class)
+class NetworkChangeCallbackTest {
+  private lateinit var manager: ConnectivityManager
+  private lateinit var callback: ConnectivityManager.NetworkCallback
+  private lateinit var dns: DnsConfig
+  private val notifications = mutableListOf<String>()
+
+  @Before
+  fun setUp() {
+    // The monitor owns process-wide state; isolate tests without adding a production reset API.
+    val networks = NetworkChangeCallback::class.java.getDeclaredField("activeNetworks")
+    networks.isAccessible = true
+    (networks.get(NetworkChangeCallback) as MutableMap<*, *>).clear()
+    TSLog.libtailscaleWrapper = mock(TSLog.LibtailscaleWrapper::class.java)
+    manager = mock(ConnectivityManager::class.java)
+    dns = DnsConfig()
+    notifications.clear()
+    doAnswer { invocation ->
+      callback = invocation.getArgument(1)
+      null
+    }.`when`(manager).registerNetworkCallback(
+        any(NetworkRequest::class.java), any(ConnectivityManager.NetworkCallback::class.java))
+    NetworkChangeCallback.monitorDnsChanges(manager, dns) { notifications.add(it) }
+  }
+
+  private fun capabilities() = mock(NetworkCapabilities::class.java).also {
+    `when`(it.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)).thenReturn(true)
+    `when`(it.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_VPN)).thenReturn(true)
+  }
+
+  private fun properties(iface: String = "wlan0") = mock(LinkProperties::class.java).also {
+    `when`(it.interfaceName).thenReturn(iface)
+    `when`(it.dnsServers).thenReturn(listOf(InetAddress.getByName("192.0.2.53")))
+    `when`(it.domains).thenReturn("example.test")
+  }
+
+  private fun network(): Network {
+    val network = mock(Network::class.java)
+    val caps = capabilities()
+    val props = properties()
+    `when`(manager.getNetworkCapabilities(network)).thenReturn(caps)
+    `when`(manager.getLinkProperties(network)).thenReturn(props)
+    return network
+  }
+
+  private fun connect(network: Network) {
+    callback.onAvailable(network)
+    callback.onCapabilitiesChanged(network, capabilities())
+    callback.onLinkPropertiesChanged(network, properties())
+  }
+
+  @Test
+  fun api22AvailableAloneSelectsNetworkAndPublishesDnsAndRoute() {
+    val network = network()
+    callback.onAvailable(network)
+    assertSame(network, NetworkChangeCallback.cachedDefaultNetwork)
+    assertEquals("wlan0", NetworkChangeCallback.cachedDefaultInterfaceName)
+    assertEquals("192.0.2.53 \nexample.test", dns.dnsConfigAsString)
+    assertEquals(listOf("wlan0"), notifications)
+  }
+
+  @Test
+  @Config(sdk = [28])
+  fun modernInitialCallbacksPublishOnlyCompleteRoute() {
+    val network = network()
+    dns.updateDNSFromNetwork("previous DNS")
+    callback.onAvailable(network)
+    assertEquals("previous DNS", dns.dnsConfigAsString)
+    assertTrue(notifications.isEmpty())
+    callback.onCapabilitiesChanged(network, capabilities())
+    assertEquals("previous DNS", dns.dnsConfigAsString)
+    assertTrue(notifications.isEmpty())
+    callback.onLinkPropertiesChanged(network, properties())
+    assertEquals(listOf("wlan0"), notifications)
+    assertEquals("192.0.2.53 \nexample.test", dns.dnsConfigAsString)
+  }
+
+  @Test
+  fun reconnectWithUnchangedDnsStillPublishesRoute() {
+    val first = network()
+    connect(first)
+    val replacement = network()
+    callback.onAvailable(replacement)
+    callback.onCapabilitiesChanged(replacement, capabilities())
+    callback.onLinkPropertiesChanged(replacement, properties())
+    notifications.clear()
+    callback.onLost(first)
+    assertSame(replacement, NetworkChangeCallback.cachedDefaultNetwork)
+    assertEquals("192.0.2.53 \nexample.test", dns.dnsConfigAsString)
+    assertEquals(listOf("wlan0"), notifications)
+  }
+
+  @Test
+  fun unchangedLinkPropertiesStillPublishRoute() {
+    val network = network()
+    connect(network)
+    notifications.clear()
+    callback.onLinkPropertiesChanged(network, properties())
+    assertEquals("192.0.2.53 \nexample.test", dns.dnsConfigAsString)
+    assertEquals(listOf("wlan0"), notifications)
+  }
+
+  @Test
+  fun losingLastNetworkClearsDnsAndPublishesNoRoute() {
+    val network = network()
+    connect(network)
+    notifications.clear()
+    callback.onLost(network)
+    assertNull(NetworkChangeCallback.cachedDefaultNetwork)
+    assertNull(NetworkChangeCallback.cachedDefaultInterfaceName)
+    assertEquals("", dns.dnsConfigAsString)
+    assertEquals(listOf(""), notifications)
+  }
+
+  @Test
+  fun capabilityLossAndRecoveryRefreshDnsAndRoute() {
+    val network = network()
+    connect(network)
+    notifications.clear()
+    callback.onCapabilitiesChanged(network, NetworkCapabilities())
+    assertNull(NetworkChangeCallback.cachedDefaultNetwork)
+    assertEquals("", dns.dnsConfigAsString)
+    assertEquals(listOf(""), notifications)
+    callback.onCapabilitiesChanged(network, capabilities())
+    assertSame(network, NetworkChangeCallback.cachedDefaultNetwork)
+    assertEquals("192.0.2.53 \nexample.test", dns.dnsConfigAsString)
+    assertEquals(listOf("", "wlan0"), notifications)
+  }
+}
