+++ b/libtailscale/callbacks_test.go
@@ -0,0 +1,97 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package libtailscale
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+)
+
+func testNetworkChanges() (chan string, func(string)) {
+	changes := make(chan string, 1)
+	var mu sync.Mutex
+	return changes, func(iface string) { queueLatestNetworkChange(changes, &mu, iface) }
+}
+
+func TestNetworkChangeBurstKeepsLatestRoute(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		inputs []string
+		want   string
+	}{
+		{"initial network becomes available", []string{"", "wlan0"}, "wlan0"},
+		{"network recovers on cellular", []string{"wlan0", "", "rmnet0"}, "rmnet0"},
+		{"last network disappears", []string{"wlan0", ""}, ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			changes, notify := testNetworkChanges()
+			for _, iface := range tt.inputs {
+				notify(iface)
+			}
+			select {
+			case got := <-changes:
+				if got != tt.want {
+					t.Fatalf("route after burst = %q; want %q", got, tt.want)
+				}
+			default:
+				t.Fatal("missing network notification")
+			}
+			select {
+			case stale := <-changes:
+				t.Fatalf("stale route remains queued: %q", stale)
+			default:
+			}
+		})
+	}
+}
+
+func TestNetworkChangeRepeatedRouteStillNotifies(t *testing.T) {
+	changes, notify := testNetworkChanges()
+	for range 3 {
+		notify("wlan0")
+		select {
+		case got := <-changes:
+			if got != "wlan0" {
+				t.Fatalf("route = %q; want wlan0", got)
+			}
+		default:
+			t.Fatal("unchanged route did not notify")
+		}
+	}
+}
+
+func TestNetworkChangeConcurrentWritersKeepFinalRoute(t *testing.T) {
+	changes, notify := testNetworkChanges()
+	var writers sync.WaitGroup
+	for writer := range 16 {
+		writers.Add(1)
+		go func() {
+			defer writers.Done()
+			for update := range 100 {
+				notify(fmt.Sprintf("iface-%d-%d", writer, update))
+			}
+		}()
+	}
+	done := make(chan struct{})
+	go func() {
+		writers.Wait()
+		notify("rmnet0")
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("network change writers blocked without a consumer")
+	}
+	select {
+	case got := <-changes:
+		if got != "rmnet0" {
+			t.Fatalf("final route = %q; want rmnet0", got)
+		}
+	default:
+		t.Fatal("missing final route notification")
+	}
+}
