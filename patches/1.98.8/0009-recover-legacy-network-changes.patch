@@ -0,0 +1,24 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package libtailscale
+
+import "sync"
+
+// queueLatestNetworkChange replaces a pending route in a one-element channel.
+// Serialize senders so the newest route cannot be dropped or block on enqueue.
+func queueLatestNetworkChange(changes chan string, mu *sync.Mutex, ifname string) {
+	mu.Lock()
+	defer mu.Unlock()
+
+	select {
+	case changes <- ifname:
+	default:
+		// The receiver may already have consumed the pending route.
+		select {
+		case <-changes:
+		default:
+		}
+		changes <- ifname
+	}
+}
